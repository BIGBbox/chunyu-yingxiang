.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #d0d0d0;
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
}
.bar-brand {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 0 20rpx;
  overflow: hidden;
}
.bar-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8e8e8;
  flex-shrink: 0;
}
.bar-name {
  flex: 1 1 0;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}
.bar-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  flex: 0 0 auto;
}
.bar-btn {
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 400;
  color: #222;
  background: #fff;
  border: none;
  border-left: 2rpx solid #c8c8c8;
  border-radius: 0;
  line-height: 100rpx;
  height: 100rpx;
  box-sizing: border-box;
}
.bar-btn::after {
  border: none;
}
.bar-consult {
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: #1a1a1a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 100rpx;
  height: 100rpx;
  box-sizing: border-box;
}
.bar-consult::after {
  border: none;
}

.page { padding: 24rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }
.nav-bar {
  margin: -24rpx -24rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 24rpx;
}
.nav-back {
  position: absolute;
  left: 8rpx;
  top: 0;
  bottom: 0;
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-ico {
  font-size: 48rpx;
  color: #333;
  line-height: 1;
  margin-top: -4rpx;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}
.pref-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx 28rpx; margin-bottom: 20rpx;
}
.toolbar { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.add-btn { padding: 16rpx 28rpx; border-radius: 32rpx; font-size: 26rpx; background: linear-gradient(135deg, #8b6cff, #6a4dff); color: #fff; }
.list-card { display: flex; align-items: center; background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; }
.thumb { width: 140rpx; height: 180rpx; background: #eee; flex-shrink: 0; }
.list-body { flex: 1; padding: 20rpx 24rpx; min-width: 0; }
.list-name { font-size: 28rpx; font-weight: 600; }
.badge-hide {
  margin-left: 10rpx; font-size: 20rpx; font-weight: 400; color: #fff;
  background: #999; padding: 2rpx 10rpx; border-radius: 16rpx; vertical-align: middle;
}
.list-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.list-actions { margin-top: 16rpx; display: flex; gap: 28rpx; }
.link { font-size: 26rpx; color: #6a4dff; }
.link.danger { color: #e03131; }
.arrow { padding-right: 8rpx; color: #ccc; font-size: 36rpx; }
.op-del { padding: 20rpx 24rpx; color: #e03131; font-size: 24rpx; flex-shrink: 0; }
.switch-row {
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  margin-top: 24rpx;
}
.switch-label { flex: 1; min-width: 0; }
.switch-title { font-size: 26rpx; color: #666; }
.switch-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; line-height: 1.4; }
.danger-link { margin-top: 32rpx; text-align: center; color: #e03131; font-size: 26rpx; }
.form-card { background: #fff; border-radius: 20rpx; padding: 28rpx; }
.edit-head { margin-bottom: 8rpx; }
.back-link { display: inline-block; font-size: 24rpx; color: #6a4dff; }
.label { font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; }
.label:first-child { margin-top: 0; }
.input { background: #f7f7f7; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 28rpx; }
.img-row { display: flex; align-items: center; gap: 16rpx; }
.cover { width: 160rpx; height: 200rpx; border-radius: 12rpx; background: #eee; }
.upload-btn { padding: 16rpx 24rpx; background: #f0ebff; color: #6a4dff; border-radius: 12rpx; font-size: 26rpx; }
.footer-btns {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff;
}
.btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx; }
.btn.ghost { background: #f5f5f5; color: #666; }
.btn.primary { background: linear-gradient(135deg, #8b6cff, #6a4dff); color: #fff; }

<view class="page">
  <view class="form-card switch-card">
    <view class="switch-row">
      <view class="switch-label">
        <view class="switch-title">首页展示小红书</view>
        <!-- <view class="switch-sub">与门店、抖音互不影响。拨动后立即保存到 COS。</view> -->
      </view>
      <switch checked="{{xhsEnabled}}" data-key="xhs" color="#6a4dff" bindchange="onTogglePlatform" />
    </view>
    <view class="switch-row switch-row--split">
      <view class="switch-label">
        <view class="switch-title">首页展示抖音</view>
        <!-- <view class="switch-sub">可只开其中一个。关闭后游客端不显示该账号。</view> -->
      </view>
      <switch checked="{{douyinEnabled}}" data-key="douyin" color="#6a4dff" bindchange="onTogglePlatform" />
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'xhs' ? 'on' : ''}}" data-tab="xhs" bindtap="onTab">小红书</view>
    <view class="tab {{tab === 'douyin' ? 'on' : ''}}" data-tab="douyin" bindtap="onTab">抖音</view>
  </view>
  <view class="form-card">
    <view class="label">展示名称</view>
    <input class="input" data-field="name" value="{{form.name}}" bindinput="onInput" />
    <view class="label">账号名</view>
    <input class="input" data-field="account" value="{{form.account}}" bindinput="onInput" />
    <view class="label">账号 ID 文案</view>
    <input class="input" data-field="id" value="{{form.id}}" bindinput="onInput" />
    <view class="label">头像</view>
    <view class="img-row">
      <image wx:if="{{form.avatar}}" class="mini" src="{{form.avatar}}" mode="aspectFill" />
      <view class="upload-btn" bindtap="onUploadAvatar">上传</view>
    </view>
    <view class="label" wx:if="{{tab === 'xhs'}}">Banner</view>
    <view class="img-row" wx:if="{{tab === 'xhs'}}">
      <image wx:if="{{form.banner}}" class="banner" src="{{form.banner}}" mode="aspectFill" />
      <view class="upload-btn" bindtap="onUploadBanner">上传</view>
    </view>
    <view class="label">二维码</view>
    <view class="img-row">
      <image wx:if="{{form.qrcode}}" class="qr" src="{{form.qrcode}}" mode="aspectFill" />
      <view class="upload-btn" bindtap="onUploadQr">上传</view>
    </view>
  </view>
  <view class="footer-btns">
    <view class="btn primary" bindtap="onSave">保存到 COS</view>
  </view>
</view>

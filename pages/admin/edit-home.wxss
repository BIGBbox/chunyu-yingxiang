.page { padding: 24rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #f5f5f5; }
.form-card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.block-title { font-size: 30rpx; font-weight: 700; margin-bottom: 8rpx; }
.hint { font-size: 22rpx; color: #999; line-height: 1.5; margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; }
.input, .textarea {
  background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
  width: 100%; box-sizing: border-box;
}
.input { height: 84rpx; padding: 0 24rpx; }
.textarea { min-height: 120rpx; padding: 20rpx 24rpx; }
.cover-list { display: flex; flex-direction: column; gap: 24rpx; }
.cover-slot { padding-bottom: 20rpx; border-bottom: 1rpx solid #f0f0f0; }
.cover-slot:last-child { border-bottom: none; padding-bottom: 0; }
.cover-slot-head { display: flex; justify-content: space-between; font-size: 26rpx; margin-bottom: 12rpx; }
.cover-type { color: #6a4dff; }
.cover-preview { position: relative; width: 240rpx; height: 320rpx; }
.cover-preview image { width: 100%; height: 100%; border-radius: 12rpx; background: #eee; }
.rm {
  position: absolute; top: -8rpx; right: -8rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,0.6); color: #fff; text-align: center; line-height: 40rpx;
}
.cover-actions { margin-top: 12rpx; }
.mini-btn {
  display: inline-block; padding: 12rpx 28rpx; border-radius: 28rpx;
  background: #f0ebff; color: #6a4dff; font-size: 24rpx;
}
.loc-box {
  background: #f7f7f7; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx;
}
.loc-addr { font-size: 28rpx; color: #222; line-height: 1.5; }
.loc-coord { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.loc-empty { font-size: 26rpx; color: #bbb; margin-bottom: 16rpx; }
.loc-btn { margin-bottom: 8rpx; }
.wxacode-row {
  display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx;
}
.wxacode-preview {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; background: #f0f0f0;
}
.avatar-preview {
  width: 96rpx; height: 96rpx; border-radius: 50%; background: #f0f0f0;
}
.mini-btn.ghost {
  background: #f5f5f5; color: #666;
}
.footer-btns {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff;
}
.btn.primary {
  height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx;
  background: linear-gradient(135deg, #8b6cff, #6a4dff); color: #fff; font-size: 28rpx;
}

.page { padding: 24rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #f5f5f5; }
.toolbar { display: flex; justify-content: flex-end; margin-bottom: 20rpx; }
.add-btn {
  padding: 12rpx 28rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #8b6cff, #6a4dff); color: #fff; font-size: 26rpx;
}
.list-card {
  display: flex; gap: 20rpx; background: #fff; border-radius: 16rpx;
  padding: 20rpx; margin-bottom: 16rpx;
}
.thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #eee; flex-shrink: 0; }
.thumb.placeholder {
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #bbb;
}
.list-body { flex: 1; min-width: 0; }
.list-name {
  font-size: 28rpx; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.list-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.list-actions { margin-top: 16rpx; display: flex; gap: 28rpx; }
.link { font-size: 26rpx; color: #6a4dff; }
.link.danger { color: #e54; }
.empty { padding: 80rpx 0; text-align: center; color: #bbb; }

.form-card { background: #fff; border-radius: 20rpx; padding: 28rpx; }
.label { font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; }
.label:first-child { margin-top: 0; }
.input, .textarea {
  background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
  width: 100%; box-sizing: border-box;
}
.input { height: 84rpx; padding: 0 24rpx; }
.textarea { min-height: 140rpx; padding: 20rpx 24rpx; }
.hint { font-size: 22rpx; color: #999; margin-top: 16rpx; line-height: 1.5; }
.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.img-item { position: relative; width: 160rpx; height: 160rpx; }
.img-item image { width: 100%; height: 100%; border-radius: 12rpx; background: #eee; }
.rm {
  position: absolute; top: -8rpx; right: -8rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,0.6); color: #fff; text-align: center; line-height: 40rpx;
}
.upload-tile {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; border: 2rpx dashed #ccc;
  display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: #bbb;
}
.footer-btns {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff;
  display: flex; gap: 20rpx;
}
.btn {
  flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx;
}
.btn.primary { background: linear-gradient(135deg, #8b6cff, #6a4dff); color: #fff; }
.btn.ghost { background: #f2f2f2; color: #666; }

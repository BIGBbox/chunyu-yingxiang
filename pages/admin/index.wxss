.page { padding: 24rpx; min-height: 100vh; background: #f5f5f5; }
.card {
  background: #fff; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: var(--shadow);
}
.title { font-size: 36rpx; font-weight: 700; margin-bottom: 12rpx; }
.desc, .hint { font-size: 26rpx; color: #888; line-height: 1.5; margin-top: 12rpx; }
.stats { font-size: 28rpx; color: #555; margin: 16rpx 0 8rpx; }
.status { font-size: 26rpx; margin-top: 8rpx; }
.status.ok { color: #2f9e44; }
.status.bad { color: #e03131; }
.url { font-size: 22rpx; color: #aaa; margin-top: 8rpx; word-break: break-all; }
.alert {
  margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: #fff5f5; color: #c92a2a; border: 2rpx solid #ffc9c9;
  font-size: 24rpx; line-height: 1.5;
}
.note {
  margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  background: #fff8e6; color: #9a6b00;
  font-size: 22rpx; line-height: 1.55; word-break: break-all;
}
.btn {
  margin-top: 20rpx; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 40rpx; font-size: 28rpx;
}
.btn.primary { background: linear-gradient(135deg, #8b6cff 0%, #6a4dff 100%); color: #fff; }
.btn.ghost { background: #f5f5f5; color: #666; }
.btn.danger { background: #fff5f5; color: #e03131; border: 2rpx solid #ffc9c9; }
.menu {
  background: #fff; border-radius: 20rpx; overflow: hidden; margin-bottom: 24rpx; box-shadow: var(--shadow);
}
.menu-item { position: relative; padding: 32rpx 28rpx; border-bottom: 1rpx solid #f0f0f0; }
.menu-item:last-child { border-bottom: none; }
.menu-title { display: block; font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.menu-sub { display: block; font-size: 24rpx; color: #999; padding-right: 40rpx; }
.arrow { position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: #ccc; }
.switch-row {
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
}
.switch-label { flex: 1; min-width: 0; }
.switch-title { font-size: 30rpx; font-weight: 600; }
.switch-sub { font-size: 22rpx; color: #999; margin-top: 8rpx; line-height: 1.4; }

<view class="page">
  <view class="menu">
    <view class="menu-item" bindtap="goEditHome">
      <text class="menu-title">首页封面与工作室</text>
      <text class="menu-sub">5 槽封面图/视频、介绍、标签、电话与位置</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditFeeds">
      <text class="menu-title">动态管理</text>
      <text class="menu-sub">文案与九宫格图片</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditSeries">
      <text class="menu-title">系列管理</text>
      <text class="menu-sub">新增、隐藏或删除系列</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditStore">
      <text class="menu-title">门店信息</text>
      <text class="menu-sub">展示开关、地址、环境图</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="switch-row">
      <view class="switch-label">
        <view class="switch-title">游客端显示水印</view>
        <view class="switch-sub">开启后 COS 图片按样式 watermark 处理；默认关闭。管理端编辑仍用原图。</view>
      </view>
      <switch checked="{{watermarkEnabled}}" color="#6a4dff" bindchange="onToggleWatermark" />
    </view>
    <view class="switch-row" style="margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #eee;">
      <view class="switch-label">
        <view class="switch-title">允许转发 / 分享</view>
        <view class="switch-sub">关闭后右上角「转发」「分享到朋友圈」会隐藏；默认开启。改完无需重新发版。</view>
      </view>
      <switch checked="{{shareEnabled}}" color="#6a4dff" bindchange="onToggleShare" />
    </view>
  </view>
</view>

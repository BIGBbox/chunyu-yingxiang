<view class="page">
  <view class="card">
    <view class="title">COS 内容管理</view>
    <view class="stats">系列 {{seriesCount}} · 客片 {{styleCount}}</view>
    <view class="status {{configured ? 'ok' : 'bad'}}">
      {{configured ? '当前配置：' + profileName : '尚未同步 COS（管理员登录后会自动写入）'}}
      <text wx:if="{{profileCount > 1}}">（共 {{profileCount}} 套）</text>
    </view>
    <view class="url" wx:if="{{baseUrl}}">{{baseUrl}}</view>
    <view class="url" wx:if="{{updatedAt}}">数据更新时间：{{updatedAt}}</view>

    <view class="alert" wx:if="{{!guestReady}}">
      其他用户看不到你的更新：config.js 的 baseUrl 仍是占位值（{{guestBaseUrl || '空'}}），需改成真实域名并重新发布小程序。
    </view>
    <view class="alert" wx:elif="{{guestMismatch}}">
      config.js 的 baseUrl（{{guestBaseUrl}}）与当前配置不一致，其他用户读的是前者。
    </view>


    <view class="btn primary" bindtap="goSettings">查看 COS 状态</view>
  </view>

  <view class="card">
    <view class="switch-row">
      <view class="switch-label">
        <view class="switch-title">游客端显示水印</view>
        <view class="switch-sub">开启后 COS 图片按样式 watermark 处理；默认关闭。管理端编辑仍用原图。</view>
      </view>
      <switch checked="{{watermarkEnabled}}" color="#6a4dff" bindchange="onToggleWatermark" />
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goEditStyle">
      <text class="menu-title">客片管理</text>
      <text class="menu-sub">上传轮播/详情图、编辑套餐文案</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditSeries">
      <text class="menu-title">系列管理</text>
      <text class="menu-sub">新增、隐藏或删除系列</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditStore">
      <text class="menu-title">门店信息</text>
      <text class="menu-sub">展示开关、地址、环境图</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goEditSocial">
      <text class="menu-title">社交账号</text>
      <text class="menu-sub">小红书、抖音可分别开关</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="card">
    <view class="btn ghost" bindtap="onReload">从 COS 重新拉取</view>
    <view class="btn danger" bindtap="onUploadSeed">上传本地演示数据到 COS</view>
    <view class="btn primary" bindtap="onMigrateImages">迁移演示图片到 COS</view>
    <view class="hint">管理员登录成功后会自动写入 SCF 下发的 COS，一般不用手填。首次可上传演示数据，再迁移演示图片到桶。</view>
  </view>
</view>

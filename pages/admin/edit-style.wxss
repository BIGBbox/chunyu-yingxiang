.page { padding: 24rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #f5f5f5; }
.toolbar { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.filter-btn, .add-btn { padding: 16rpx 28rpx; border-radius: 32rpx; font-size: 26rpx; background: #fff; }
.add-btn { background: linear-gradient(135deg, #8b6cff 0%, #6a4dff 100%); color: #fff; }
.list-card { display: flex; background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 16rpx; }
.thumb { width: 160rpx; height: 200rpx; background: #eee; flex-shrink: 0; }
.list-body { flex: 1; padding: 20rpx 24rpx; }
.list-name { font-size: 28rpx; font-weight: 600; }
.list-sub { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.list-actions { margin-top: 16rpx; }
.link { font-size: 26rpx; color: #6a4dff; margin-right: 28rpx; }
.link.danger { color: #e03131; }
.empty { text-align: center; color: #999; padding: 80rpx 0; }
.form-card { background: #fff; border-radius: 20rpx; padding: 28rpx; }
.label { font-size: 26rpx; color: #666; margin: 24rpx 0 12rpx; }
.label:first-child { margin-top: 0; }
.input, .picker-val, .textarea {
  background: #f7f7f7; border-radius: 12rpx; font-size: 28rpx;
  width: 100%; box-sizing: border-box;
}
/* 单行输入必须给足高度：border-box 下上下 padding 会挤压内容区导致文字被裁切 */
.input { height: 84rpx; padding: 0 24rpx; }
.picker-val { height: 84rpx; line-height: 84rpx; padding: 0 24rpx; }
.textarea { min-height: 120rpx; padding: 20rpx 24rpx; }
.img-row { display: flex; align-items: center; gap: 16rpx; }
.mini { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eee; }
.upload-btn { padding: 16rpx 24rpx; background: #f0ebff; color: #6a4dff; border-radius: 12rpx; font-size: 26rpx; }
.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.img-item { position: relative; width: 160rpx; height: 160rpx; }
.img-item image { width: 100%; height: 100%; border-radius: 12rpx; background: #eee; }
.rm {
  position: absolute; top: -8rpx; right: -8rpx; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(0,0,0,0.6); color: #fff; text-align: center; line-height: 40rpx; font-size: 28rpx;
}
.upload-tile {
  width: 160rpx; height: 160rpx; border-radius: 12rpx; border: 2rpx dashed #ccc;
  display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: #bbb;
}
.footer-btns {
  position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 40rpx; font-size: 28rpx; }
.btn.ghost { background: #f5f5f5; color: #666; }
.btn.primary { background: linear-gradient(135deg, #8b6cff 0%, #6a4dff 100%); color: #fff; }

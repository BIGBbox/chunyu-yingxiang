<view class="page">
  <block wx:if="{{mode === 'list'}}">
    <view class="toolbar">
      <picker mode="selector" range="{{filterLabels}}" bindchange="onFilterSeries">
        <view class="filter-btn">筛选系列</view>
      </picker>
      <view class="add-btn" bindtap="onCreate">+ 新建客片</view>
    </view>
    <view class="list-card" wx:for="{{filtered}}" wx:key="id">
      <image class="thumb" src="{{item.cover}}" mode="aspectFill" />
      <view class="list-body">
        <view class="list-name">{{item.name}}</view>
        <view class="list-sub">{{seriesNames[item.seriesId] || '未归类'}}</view>
        <view class="list-actions">
          <text class="link" data-id="{{item.id}}" bindtap="onEdit">编辑</text>
          <text class="link danger" data-id="{{item.id}}" bindtap="onDelete">删除</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!filtered.length}}">暂无客片</view>
  </block>

  <block wx:else>
    <view class="form-card">
      <view class="label">所属系列</view>
      <picker mode="selector" range="{{seriesLabels}}" value="{{formSeriesIndex}}" bindchange="onSeriesPick">
        <view class="picker-val">{{seriesNames[form.seriesId] || '未归类'}}</view>
      </picker>

      <view class="label">客片名称</view>
      <input class="input" data-field="name" value="{{form.name}}" bindinput="onInput" />

      <view class="label">排序</view>
      <input class="input" type="number" data-field="sort" value="{{form.sort}}" bindinput="onInput" />

      <view class="label">头像</view>
      <view class="img-row">
        <image wx:if="{{form.avatar}}" class="mini" src="{{form.avatar}}" mode="aspectFill" />
        <view class="upload-btn" bindtap="onUploadAvatar">上传头像</view>
      </view>

      <view class="label">顶部轮播图</view>
      <view class="img-grid">
        <view class="img-item" wx:for="{{form.images}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" />
          <view class="rm" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view class="upload-tile" bindtap="onUploadImages">+</view>
      </view>

      <view class="label">底部详情大图</view>
      <view class="img-grid">
        <view class="img-item" wx:for="{{form.gallery}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" />
          <view class="rm" data-index="{{index}}" bindtap="onRemoveGallery">×</view>
        </view>
        <view class="upload-tile" bindtap="onUploadGallery">+</view>
      </view>

      <view class="label">套餐 · 客片标题</view>
      <input class="input" data-field="title" value="{{form.package.title}}" bindinput="onPkgInput" />
      <view class="label">套餐 · 拍摄场景</view>
      <textarea class="textarea" data-field="scene" value="{{form.package.scene}}" bindinput="onPkgInput" auto-height />
      <view class="label">套餐 · 服务内容</view>
      <textarea class="textarea" data-field="service" value="{{form.package.service}}" bindinput="onPkgInput" auto-height />
      <view class="label">套餐 · 拍摄内容</view>
      <textarea class="textarea" data-field="shooting" value="{{form.package.shooting}}" bindinput="onPkgInput" auto-height />
      <view class="label">套餐 · 服装造型</view>
      <textarea class="textarea" data-field="clothing" value="{{form.package.clothing}}" bindinput="onPkgInput" auto-height />
      <view class="label">套餐 · 备注</view>
      <textarea class="textarea" data-field="remark" value="{{form.package.remark}}" bindinput="onPkgInput" auto-height />
    </view>
    <view class="footer-btns">
      <view class="btn ghost" bindtap="onBackList">返回</view>
      <view class="btn primary" bindtap="onSave">保存到 COS</view>
    </view>
  </block>
</view>

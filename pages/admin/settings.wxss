.page { padding: 24rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; background: #f5f5f5; }
.tip {
  background: #fff8e6; color: #9a6b00; font-size: 24rpx; line-height: 1.5;
  padding: 20rpx 24rpx; border-radius: 12rpx; margin-bottom: 20rpx;
}
.warn {
  background: #fff5f5; color: #c92a2a; font-size: 24rpx; line-height: 1.5;
  padding: 20rpx 24rpx; border-radius: 12rpx; margin-bottom: 20rpx;
  border: 2rpx solid #ffc9c9;
}
.card {
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.status { font-size: 26rpx; margin-bottom: 16rpx; }
.status.ok { color: #2f9e44; }
.status.bad { color: #e03131; }
.row {
  display: flex; gap: 20rpx; padding: 12rpx 0;
  border-top: 1rpx solid #f5f5f5; font-size: 26rpx;
}
.k { width: 80rpx; color: #999; flex-shrink: 0; }
.v { flex: 1; color: #333; word-break: break-all; }
.probe-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.probe-head .card-title { margin-bottom: 0; }
.btn-probe {
  padding: 0 28rpx; height: 64rpx; line-height: 64rpx; border-radius: 32rpx;
  background: #f0ebff; color: #6a4dff; font-size: 26rpx; flex-shrink: 0;
}
.btn-probe.disabled { opacity: 0.5; }
.probe-summary {
  margin-top: 20rpx; padding: 16rpx 20rpx; border-radius: 12rpx;
  font-size: 26rpx; font-weight: 500;
}
.probe-summary.ok { background: #ebfbee; color: #2f9e44; }
.probe-summary.bad { background: #fff5f5; color: #e03131; }
.probe-steps { margin-top: 8rpx; }
.probe-step {
  display: flex; gap: 16rpx; padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.probe-step:last-child { border-bottom: none; }
.probe-badge {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  text-align: center; line-height: 44rpx; font-size: 24rpx; flex-shrink: 0;
}
.probe-badge.ok { background: #d3f9d8; color: #2f9e44; }
.probe-badge.bad { background: #ffe3e3; color: #e03131; }
.probe-body { flex: 1; min-width: 0; }
.probe-name { font-size: 28rpx; font-weight: 500; margin-bottom: 6rpx; }
.probe-msg { font-size: 24rpx; color: #888; line-height: 1.45; word-break: break-all; }
.btn-clear {
  margin-top: 8rpx; height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 40rpx; font-size: 28rpx; background: #fff5f5; color: #e03131;
  border: 2rpx solid #ffc9c9;
}

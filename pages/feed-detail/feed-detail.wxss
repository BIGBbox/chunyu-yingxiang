.page {
  min-height: 100vh;
  background: #fff;
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.feed-text {
  font-size: 30rpx;
  font-weight: 400;
  color: #333;
  line-height: 1.65;
  margin-bottom: 20rpx;
}
.feed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.feed-img {
  background: #eee;
  border-radius: 0;
}
.feed-grid-1 .feed-img,
.feed-grid-2 .feed-img,
.feed-grid-3 .feed-img,
.feed-grid-5 .feed-img,
.feed-grid-6 .feed-img,
.feed-grid-7 .feed-img,
.feed-grid-8 .feed-img,
.feed-grid-9 .feed-img {
  width: calc((100% - 12rpx) / 3);
  height: 220rpx;
}
.feed-grid-1 .feed-img {
  width: 60%;
  height: 360rpx;
}
.feed-grid-4 .feed-img {
  width: calc((100% - 6rpx) / 2);
  height: 333rpx;
}
.feed-time {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #bbb;
}
.comment-section {
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #eee;
}
.comment-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 24rpx;
}
.comment-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #e8e8e8;
  flex-shrink: 0;
}
.comment-body {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}
.comment-nick {
  color: #666;
  margin-right: 8rpx;
}
.comment-empty {
  padding: 24rpx 0 48rpx;
  color: #bbb;
  font-size: 26rpx;
}
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #bbb;
}

.comment-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 600;
  display: flex;
  align-items: flex-end;
}
.comment-sheet {
  width: 100%;
  background: #fff;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.comment-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.comment-nick-field {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.comment-input {
  flex: 1;
  height: 88rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-send {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}
.comment-send::after {
  border: none;
}

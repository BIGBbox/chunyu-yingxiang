.page {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.page-main { flex: 1 0 auto; }
.page-footer {
  flex-shrink: 0;
  margin-top: auto;
  padding-top: 48rpx;
}
.search-bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 32rpx; }
.search-input-wrap {
  flex: 1; display: flex; align-items: center; height: 72rpx; padding: 0 24rpx;
  background: #fff; border-radius: 36rpx; box-shadow: var(--shadow);
}
.search-icon { font-size: 32rpx; color: #bbb; margin-right: 12rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 26rpx; }
.search-ph { color: #bbb; font-size: 26rpx; }
.search-btn {
  flex-shrink: 0; height: 72rpx; padding: 0 28rpx; line-height: 72rpx; border-radius: 36rpx;
  background: linear-gradient(135deg, #8b6cff 0%, #6a4dff 100%); color: #fff; font-size: 26rpx;
}
.section-title { font-size: 34rpx; font-weight: 700; margin-bottom: 24rpx; }
.section-title--gap { margin-top: 48rpx; }
.series-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.series-card {
  width: calc(50% - 10rpx); margin-bottom: 20rpx; background: #fff;
  border-radius: 20rpx; overflow: hidden; box-shadow: var(--shadow);
}
.series-card:active { opacity: 0.85; }
.series-cover { width: 100%; height: 420rpx; display: block; background: #eee; }
.series-name { text-align: center; padding: 20rpx 12rpx; font-size: 28rpx; font-weight: 500; }
.social-row { display: flex; gap: 20rpx; }
.social-card {
  flex: 1; background: #fff; border-radius: 20rpx; overflow: hidden;
  box-shadow: var(--shadow); padding-bottom: 20rpx;
}
.social-head { padding: 20rpx 24rpx 12rpx; font-size: 28rpx; font-weight: 600; }
.social-banner { width: 100%; height: 120rpx; background: #f0f0f0; }
.social-profile { display: flex; align-items: center; padding: 16rpx 20rpx; gap: 12rpx; }
.social-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #eee; }
.social-meta { flex: 1; overflow: hidden; display: flex; flex-direction: column; gap: 4rpx; }
.social-account { font-size: 22rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.social-id { font-size: 20rpx; color: var(--text-secondary); }
.social-footer { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 20rpx 0; }
.platform-tag { font-size: 22rpx; color: #ff2442; font-weight: 600; }
.social-qr { width: 100rpx; height: 100rpx; border-radius: 8rpx; background: #eee; }
.dy-qr-wrap { display: flex; justify-content: center; padding: 24rpx 0 12rpx; }
.dy-qr { width: 220rpx; height: 220rpx; border-radius: 16rpx; background: #eee; }
.dy-info { display: flex; flex-direction: column; align-items: center; padding: 0 16rpx 16rpx; gap: 6rpx; }
.dy-info .social-account { text-align: center; white-space: normal; font-size: 20rpx; line-height: 1.4; }
.dy-actions {
  display: flex; justify-content: space-around; border-top: 1rpx solid #f0f0f0; padding-top: 16rpx;
}
.dy-action { font-size: 22rpx; color: #666; padding: 8rpx 16rpx; }
.store-entry {
  display: flex; align-items: center; background: #fff; border-radius: 20rpx;
  padding: 32rpx 28rpx; box-shadow: var(--shadow);
}
.store-entry:active { opacity: 0.85; }
.store-icon {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #4dabf7;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
  margin-right: 24rpx; line-height: 72rpx; text-align: center;
}
.store-entry-text { flex: 1; font-size: 32rpx; font-weight: 600; }
.store-arrow { font-size: 40rpx; color: #ccc; }

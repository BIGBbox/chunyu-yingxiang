.page {
  min-height: 100vh;
  background: #fff;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* —— 封面 —— */
.cover-wrap {
  position: relative;
  width: 100%;
  background: #111;
  overflow: hidden;
}
.cover-swiper {
  width: 100%;
  height: 100%;
}
.cover-slide {
  width: 100%;
  height: 100%;
  position: relative;
}
.cover-media {
  width: 100%;
  height: 100%;
  display: block;
  background: #222;
}
.cover-video {
  opacity: 1;
  transition: opacity 0.45s ease;
}
.cover-video.is-fading {
  opacity: 0;
}
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.45);
  font-size: 28rpx;
  background: #2a2a2a;
}
.cover-play {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  pointer-events: none;
}
.cover-play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  position: relative;
}
.cover-play-btn::after {
  content: '';
  position: absolute;
  left: 46rpx;
  top: 34rpx;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 26rpx 0 26rpx 42rpx;
  border-color: transparent transparent transparent #fff;
}
.cover-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 36rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28rpx;
  z-index: 3;
  pointer-events: none;
}
.cover-dot {
  width: 14rpx;
  height: 14rpx;
  background: transparent;
  border: 3rpx solid rgba(255, 255, 255, 0.75);
  transform: rotate(45deg);
  box-sizing: border-box;
}
.cover-dot.on {
  background: #fff;
  border-color: #fff;
}
.cover-mute {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}
.cover-mute-ico {
  width: 44rpx;
  height: 44rpx;
}
.cover-fullscreen {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}
.cover-fullscreen-ico {
  position: relative;
  width: 32rpx;
  height: 32rpx;
}
/* 全屏图标：左上 + 右下两个 L 形角 */
.cover-fullscreen-ico::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border-left: 5rpx solid #fff;
  border-top: 5rpx solid #fff;
}
.cover-fullscreen-ico::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  width: 20rpx;
  height: 20rpx;
  border-right: 5rpx solid #fff;
  border-bottom: 5rpx solid #fff;
}

/* —— 工作室卡：直角贴合封面 —— */
.studio-card {
  position: relative;
  z-index: 3;
  margin-top: 0;
  background: #fff;
  border-radius: 0;
  padding: 56rpx 16rpx 12rpx;
  text-align: center;
}
.studio-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #111;
  letter-spacing: 2rpx;
  line-height: 1.35;
}
.studio-intro {
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #666;
  line-height: 1.75;
  text-align: center;
}
.studio-tags {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx 36rpx;
}
.studio-tag {
  font-size: 28rpx;
  font-weight: 400;
  color: #999;
}
.studio-actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  gap: 48rpx;
  padding: 0;
  box-sizing: border-box;
}
.action-item {
  width: 88rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}
.action-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.action-label {
  font-size: 26rpx;
  color: #666;
  line-height: 32rpx;
  height: 32rpx;
  font-weight: 400;
  text-align: center;
}
.action-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.action-hit::after {
  border: none;
}
.studio-divider {
  margin-top: 48rpx;
  height: 1rpx;
  background: #eee;
}

/* —— 分区 —— */
.section {
  background: #fff;
  padding: 32rpx 28rpx 8rpx;
}
.section-feeds {
  padding-bottom: 24rpx;
}
.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  /* 吸顶：滚动时标题固定在视口顶部 */
  position: sticky;
  top: 0;
  z-index: 10;
  background: #fff;
  /* 负 margin 抵消 .section 左右 padding，吸顶时整行白底不露内容 */
  margin-left: -28rpx;
  margin-right: -28rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111;
}
.section-title--feeds {
  font-size: 40rpx;
  font-weight: 700;
}
.section-arrow {
  font-size: 32rpx;
  color: #111;
  margin-left: 4rpx;
  font-weight: 500;
}
.section-arrow--feeds {
  font-size: 38rpx;
  font-weight: 700;
}

.section-works {
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 24rpx;
}
.works-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.works-banner {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
  background: #ddd;
}
.works-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}
.works-banner-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.32);
}
.works-banner-name {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  z-index: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— 动态 —— */
.feed-card {
  padding-bottom: 36rpx;
  margin-bottom: 8rpx;
  border-bottom: 2rpx solid #ddd;
}
.feed-card:last-of-type {
  border-bottom: none;
}
.feed-text {
  font-size: 30rpx;
  font-weight: 400;
  color: #333;
  line-height: 1.65;
  margin-bottom: 20rpx;
}
.feed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.feed-img {
  background: #eee;
  border-radius: 0;
}
.feed-grid-1 .feed-img,
.feed-grid-2 .feed-img,
.feed-grid-3 .feed-img,
.feed-grid-5 .feed-img,
.feed-grid-6 .feed-img,
.feed-grid-7 .feed-img,
.feed-grid-8 .feed-img,
.feed-grid-9 .feed-img {
  width: calc((100% - 12rpx) / 3);
  height: 220rpx;
}
.feed-grid-1 .feed-img {
  width: 60%;
  height: 360rpx;
}
.feed-grid-4 .feed-img {
  width: calc((100% - 6rpx) / 2);
  height: 333rpx;
}
.feed-footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feed-time {
  font-size: 24rpx;
  color: #bbb;
}
.feed-ops {
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.feed-op {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feed-op-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.feed-comments {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.feed-comment-line {
  font-size: 26rpx;
  line-height: 1.55;
  color: #333;
}
.feed-comment-line + .feed-comment-line {
  margin-top: 8rpx;
}
.feed-comment-nick {
  font-weight: 600;
  color: #333;
  margin-right: 6rpx;
}
.feed-comment-text {
  color: #333;
  font-weight: 400;
}
.comment-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 600;
  display: flex;
  align-items: flex-end;
}
.comment-sheet {
  width: 100%;
  background: #fff;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.comment-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.comment-nick-field {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.comment-input {
  flex: 1;
  height: 88rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-send {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}
.comment-send::after {
  border: none;
}
.feeds-empty {
  padding: 48rpx 0 64rpx;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}
.more-feeds {
  margin: 8rpx 0 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #222;
  font-size: 28rpx;
  font-weight: 700;
}

/* —— 分享面板：左对齐、单行文案、无取消 —— */
.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 16rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.share-sheet-title {
  text-align: left;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}
.share-sheet-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.share-sheet-item {
  flex: 1;
  width: 0;
  max-width: 25%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.share-sheet-label {
  font-size: 22rpx;
  color: #333;
  line-height: 30rpx;
  height: 30rpx;
  text-align: center;
  white-space: nowrap;
}
.share-sheet-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.share-sheet-img {
  width: 48rpx;
  height: 48rpx;
}
.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.share-hit::after {
  border: none;
}

.page { padding: 24rpx; min-height: 100vh; }
.search-bar { display: flex; align-items: center; gap: 16rpx; margin-bottom: 28rpx; }
.search-input-wrap {
  flex: 1; display: flex; align-items: center; height: 72rpx; padding: 0 24rpx;
  background: #f0f0f0; border-radius: 36rpx;
}
.search-icon { font-size: 32rpx; color: #bbb; margin-right: 12rpx; }
.search-input { flex: 1; height: 72rpx; font-size: 24rpx; }
.search-ph { color: #bbb; font-size: 24rpx; }
.search-btn {
  height: 72rpx; padding: 0 28rpx; line-height: 72rpx; border-radius: 36rpx;
  background: linear-gradient(135deg, #8b6cff 0%, #6a4dff 100%); color: #fff; font-size: 26rpx;
}
.style-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.style-card {
  width: calc(50% - 10rpx); margin-bottom: 20rpx; background: #fff;
  border-radius: 20rpx; overflow: hidden; box-shadow: var(--shadow);
}
.style-cover { width: 100%; height: 420rpx; display: block; background: #eee; }
.style-name { text-align: center; padding: 20rpx 12rpx; font-size: 26rpx; line-height: 1.4; }
.empty { padding: 120rpx 0; text-align: center; color: #999; }

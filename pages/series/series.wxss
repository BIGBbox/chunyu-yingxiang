.page {
  height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.hero {
  position: relative;
  width: 100%;
  min-height: 520rpx;
  overflow: hidden;
  background: #f3eee8;
  flex-shrink: 0;
}
.hero-bg-wrap {
  position: absolute;
  left: -80rpx;
  top: -80rpx;
  right: -80rpx;
  bottom: -80rpx;
  overflow: hidden;
}
.hero-bg {
  width: 100%;
  height: 100%;
  display: block;
  transform: scale(1.35);
}
.hero-veil {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 255, 255, 0.42) 0%,
    rgba(255, 255, 255, 0.22) 70%,
    rgba(255, 255, 255, 0.12) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 1;
  padding: 0 28rpx 48rpx;
  box-sizing: border-box;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-ico {
  font-size: 48rpx;
  color: #333;
  line-height: 1;
  margin-top: -4rpx;
  margin-left: -4rpx;
}
.hero-main {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  text-align: center;
  line-height: 1.3;
  max-width: 90%;
}
.hero-count {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}
.hero-share-btn {
  margin-top: 28rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #222;
  font-weight: 600;
}

.work-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #fff;
}
.work-list {
  padding: 8rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.work-card {
  padding-bottom: 32rpx;
  margin-bottom: 32rpx;
  border-bottom: 4rpx solid #000000;
}
.work-card:last-of-type {
  border-bottom: none;
  margin-bottom: 0;
}
.work-cover {
  width: 100%;
  height: 500rpx;
  display: block;
  background: #eee;
}
.work-meta {
  padding-top: 18rpx;
}
.work-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  line-height: 1.4;
}
.work-tag {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 600;
  display: flex;
  align-items: flex-end;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 16rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.share-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  text-align: left;
}
.share-sheet-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.share-sheet-item {
  flex: 1;
  width: 0;
  max-width: 25%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.share-sheet-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.share-sheet-img {
  width: 48rpx;
  height: 48rpx;
}
.share-sheet-label {
  font-size: 22rpx;
  color: #333;
  line-height: 30rpx;
  height: 30rpx;
  text-align: center;
  white-space: nowrap;
}
.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.share-hit::after {
  border: none;
}

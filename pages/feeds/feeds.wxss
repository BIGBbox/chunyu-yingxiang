.page {
  min-height: 100vh;
  background: #fff;
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.feed-card {
  padding-bottom: 36rpx;
  margin-bottom: 8rpx;
  border-bottom: 2rpx solid #ddd;
}
.feed-card--focus {
  outline: 2rpx solid #ff4d6d;
  outline-offset: 4rpx;
}
.feed-text {
  font-size: 30rpx;
  font-weight: 400;
  color: #333;
  line-height: 1.65;
  margin-bottom: 20rpx;
}
.feed-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.feed-img {
  background: #eee;
  border-radius: 0;
}
.feed-grid-1 .feed-img,
.feed-grid-2 .feed-img,
.feed-grid-3 .feed-img,
.feed-grid-5 .feed-img,
.feed-grid-6 .feed-img,
.feed-grid-7 .feed-img,
.feed-grid-8 .feed-img,
.feed-grid-9 .feed-img {
  width: calc((100% - 12rpx) / 3);
  height: 220rpx;
}
.feed-grid-1 .feed-img {
  width: 60%;
  height: 360rpx;
}
.feed-grid-4 .feed-img {
  width: calc((100% - 6rpx) / 2);
  height: 333rpx;
}
.feed-footer {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.feed-time {
  font-size: 24rpx;
  color: #bbb;
}
.feed-ops {
  display: flex;
  align-items: center;
  gap: 40rpx;
}
.feed-op {
  padding: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feed-op-ico {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.feed-comments {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.feed-comment-line {
  font-size: 26rpx;
  line-height: 1.55;
  color: #333;
}
.feed-comment-line + .feed-comment-line {
  margin-top: 8rpx;
}
.feed-comment-nick {
  font-weight: 600;
  color: #333;
  margin-right: 6rpx;
}
.feed-comment-text {
  color: #333;
  font-weight: 400;
}
.comment-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 600;
  display: flex;
  align-items: flex-end;
}
.comment-sheet {
  width: 100%;
  background: #fff;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.comment-form {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.comment-nick-field {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.comment-input {
  flex: 1;
  height: 88rpx;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.comment-send {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}
.comment-send::after {
  border: none;
}
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #bbb;
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 16rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.share-sheet-title {
  text-align: left;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}
.share-sheet-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.share-sheet-item {
  flex: 1;
  width: 0;
  max-width: 25%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.share-sheet-label {
  font-size: 22rpx;
  color: #333;
  line-height: 30rpx;
  height: 30rpx;
  text-align: center;
  white-space: nowrap;
}
.share-sheet-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.share-sheet-img {
  width: 48rpx;
  height: 48rpx;
}
.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.share-hit::after {
  border: none;
}

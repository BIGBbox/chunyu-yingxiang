.page {
  min-height: 100vh;
  background: #fff;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.top {
  padding-left: 24rpx;
  padding-bottom: 8rpx;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-ico {
  font-size: 48rpx;
  color: #222;
  line-height: 1;
  margin-top: -4rpx;
  margin-left: -4rpx;
}
.header {
  padding: 12rpx 32rpx 28rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #111;
  line-height: 1.35;
}
.tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.copy {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee;
  font-size: 24rpx;
  color: #999;
}
.preview-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 20rpx;
}
.preview-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}
.view-toggle {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.view-ico {
  width: 40rpx;
  height: 40rpx;
}

.photos--list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 0 24rpx;
}
.photo-list {
  width: 100%;
  display: block;
  background: #f0f0f0;
  vertical-align: top;
}
.photos--grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 0 0 24rpx;
}
.photo-grid {
  width: calc((100% - 8rpx) / 2);
  height: 480rpx;
  background: #f0f0f0;
}

.scrubber {
  position: fixed;
  right: 8rpx;
  width: 28rpx;
  z-index: 400;
  display: flex;
  justify-content: center;
}
.scrubber-track {
  width: 4rpx;
  height: 100%;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 4rpx;
}
.scrubber-thumb {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.35);
}

.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 600;
  display: flex;
  align-items: flex-end;
}
.share-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 16rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.share-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}
.share-sheet-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}
.share-sheet-item {
  flex: 1;
  width: 0;
  max-width: 25%;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.share-sheet-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.share-sheet-img {
  width: 48rpx;
  height: 48rpx;
}
.share-sheet-label {
  font-size: 22rpx;
  color: #333;
  line-height: 30rpx;
  height: 30rpx;
  text-align: center;
  white-space: nowrap;
}
.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
}
.share-hit::after {
  border: none;
}
.loading {
  padding: 160rpx 0;
  text-align: center;
  color: #bbb;
}

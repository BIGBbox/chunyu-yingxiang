.page { min-height: 100vh; background: #fff; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.meta { display: flex; align-items: center; padding: 20rpx 28rpx; gap: 16rpx; }
.avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #eee; }
.meta-time { flex: 1; font-size: 24rpx; color: #999; }
.meta-views { display: flex; align-items: center; gap: 8rpx; color: #999; font-size: 24rpx; }
.hero-swiper { width: 100%; height: 880rpx; background: #111; }
.hero-img { width: 100%; height: 100%; display: block; }
.pkg { padding: 32rpx 28rpx 16rpx; }
.pkg-row { display: flex; align-items: flex-start; margin-bottom: 24rpx; line-height: 1.6; }
.pkg-label { width: 160rpx; flex-shrink: 0; font-size: 28rpx; color: #999; }
.pkg-value { flex: 1; font-size: 28rpx; color: #222; white-space: pre-wrap; word-break: break-all; }
.gallery-img { width: 100%; display: block; background: #f5f5f5; }
.loading { padding: 120rpx 0; text-align: center; color: #999; }

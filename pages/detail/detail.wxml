<view class="page" wx:if="{{!loading && detail}}">
  <view class="top" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-back" bindtap="onBack">
      <text class="nav-back-ico">‹</text>
    </view>
  </view>

  <view class="header">
    <view class="title">{{detail.name}}</view>
    <view class="tag">{{detail.name}}</view>
    <view class="copy">© {{studioName}}</view>
  </view>

  <view class="preview-bar">
    <text class="preview-label">预览</text>
    <view class="view-toggle">
      <image
        class="view-ico"
        src="{{viewMode === 'list' ? '/images/icons/view-list.png' : '/images/icons/view-list-off.png'}}"
        mode="aspectFit"
        data-mode="list"
        bindtap="onSwitchView"
      />
      <image
        class="view-ico"
        src="{{viewMode === 'grid' ? '/images/icons/view-grid.png' : '/images/icons/view-grid-off.png'}}"
        mode="aspectFit"
        data-mode="grid"
        bindtap="onSwitchView"
      />
    </view>
  </view>

  <view class="photos photos--list" wx:if="{{viewMode === 'list'}}">
    <image
      class="photo-list"
      wx:for="{{photos}}"
      wx:key="*this"
      src="{{item}}"
      mode="widthFix"
      lazy-load
      data-url="{{item}}"
      bindtap="onPreview"
    />
  </view>
  <view class="photos photos--grid" wx:else>
    <image
      class="photo-grid"
      wx:for="{{photos}}"
      wx:key="*this"
      src="{{item}}"
      mode="aspectFill"
      lazy-load
      data-url="{{item}}"
      bindtap="onPreview"
    />
  </view>

  <!-- 右侧快速滚动条 -->
  <view
    class="scrubber"
    style="top: {{scrubberTop}}px; height: {{scrubberHeight}}px;"
    catchtouchstart="onScrubStart"
    catchtouchmove="onScrubMove"
    catchtouchend="onScrubEnd"
  >
    <view class="scrubber-track" />
    <view class="scrubber-thumb" style="top: {{scrubThumbTop}}px;" />
  </view>

  <bottom-bar
    studio-name="{{studioName}}"
    avatar="{{studioAvatar}}"
    show-like="{{true}}"
    liked="{{liked}}"
    share-as-sheet="{{true}}"
    bind:home="onGoHome"
    bind:like="onToggleLike"
    bind:share="onOpenShare"
  />

  <view class="share-mask" wx:if="{{shareSheetVisible}}" bindtap="onCloseShare" catchtouchmove="noop">
    <view class="share-sheet" catchtap="noop">
      <view class="share-sheet-title">选择分享方式</view>
      <view class="share-sheet-row">
        <view class="share-sheet-item" bindtap="onShareMoments">
          <view class="share-sheet-ico">
            <image class="share-sheet-img" src="/images/icons/moments.png" mode="aspectFit" />
          </view>
          <text class="share-sheet-label">分享到朋友圈</text>
        </view>
        <view class="share-sheet-item">
          <view class="share-sheet-ico">
            <image class="share-sheet-img" src="/images/icons/share.png" mode="aspectFit" />
          </view>
          <text class="share-sheet-label">直接转发</text>
          <button class="share-hit" open-type="share" hover-class="none" bindtap="onCloseShare" />
        </view>
      </view>
    </view>
  </view>
</view>
<view class="loading" wx:if="{{loading}}">加载中...</view>
